<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Maintain Users | Greg Project</title>
  <style>
    :root { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #f4f7fb; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 5vw; background: #fff; border-bottom: 1px solid #dce3ed; }
    .header-identity { min-width: 0; overflow-wrap: anywhere; line-height: 1.45; }
    .menu-toggle { display: none; }
    .header-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; }
    .header-actions form { margin: 0; }
    main { width: min(1100px, calc(100% - 2rem)); margin: 2rem auto; padding: 0; }
    section { margin: 1.25rem 0; padding: 1.25rem; background: #fff; border: 1px solid #dce3ed; border-radius: 12px; }
    #create-form { display: flex; flex-wrap: wrap; gap: .75rem; align-items: end; }
    label { display: grid; min-width: 0; gap: .3rem; font-size: .9rem; }
    input { min-width: 0; padding: .6rem; border: 1px solid #9ba8ba; border-radius: 6px; font: inherit; }
    button, a.button { display: inline-flex; align-items: center; justify-content: center; padding: .65rem .9rem; border: 0; border-radius: 6px; color: #fff; background: #174a7e; text-decoration: none; cursor: pointer; font: inherit; font-weight: 600; }
    button.danger { background: #a52b37; }
    #status { min-height: 1.5rem; }
    .table-wrap { width: 100%; overflow-x: auto; }
    table { width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 1rem; }
    th, td { padding: .65rem; text-align: left; vertical-align: top; border-bottom: 1px solid #e1e7ef; overflow-wrap: anywhere; }
    th { color: #34445b; background: #f8fafc; }
    .row-form { display: grid; min-width: 0; gap: .45rem; }
    .row-form input { width: 100%; }
    #user-rows td::before { content: none; }
    @media (max-width: 700px) {
      header { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .75rem; padding: .9rem 1rem; }
      .header-identity { grid-column: 1; }
      .menu-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 42px; padding: .55rem .8rem; border: 1px solid #d8e0eb; border-radius: 8px; color: #243b5d; background: #f7f9fc; white-space: nowrap; }
      .header-actions { display: none; grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; gap: .5rem; }
      header.menu-open .header-actions { display: grid; }
      .header-actions > a { width: 100%; min-width: 0; min-height: 44px; padding: .55rem; text-align: center; white-space: normal; overflow-wrap: anywhere; }
      .header-actions form { grid-column: 1 / -1; width: 100%; }
      .header-actions form button { width: 100%; min-height: 44px; }
      main { width: min(100% - 1.25rem, 600px); margin: 1.25rem auto; }
      section { padding: 1rem; }
      #create-form { display: grid; grid-template-columns: minmax(0, 1fr); gap: .8rem; }
      #create-form label, #create-form input, #create-form button { width: 100%; }
      .table-wrap { overflow: visible; }
      table, tbody { display: block; width: 100%; }
      thead { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      tbody tr { display: block; width: 100%; margin: .8rem 0; padding: .35rem .85rem; border: 1px solid #e1e7ef; border-radius: 10px; background: #fff; box-shadow: 0 4px 14px rgba(23, 42, 68, .05); }
      tbody td { display: grid; grid-template-columns: minmax(5.5rem, 30%) minmax(0, 1fr); gap: .65rem; width: 100%; padding: .7rem 0; border-bottom: 1px solid #edf0f5; }
      tbody td::before { content: attr(data-label); color: #53647a; font-size: .82rem; font-weight: 700; }
      tbody td[data-label="Update"] { display: block; }
      tbody td[data-label="Update"]::before { display: block; margin-bottom: .55rem; }
      .row-form { width: 100%; min-width: 0; }
      .row-form input { width: 100%; }
      tbody td[data-label="Delete"] { display: flex; align-items: center; justify-content: space-between; }
      tbody td:last-child { border-bottom: 0; }
    }
  </style>
</head>
<body>
  <header>
    <div class="header-identity">
      <strong>Greg Project</strong>
      <span> · Signed in as <%= adminUser.email %></span>
    </div>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="admin-actions">☰ Menu</button>
    <nav class="header-actions" id="admin-actions" aria-label="Admin actions">
      <a class="button" href="https://rebekahkinghorn.github.io/cougarai/">Cougar AI main site</a>
      <a class="button" href="/">Back to Home</a>
      <form action="/logout" method="post"><button type="submit">Log out</button></form>
    </nav>
  </header>

  <main>
    <h1>Maintain Users</h1>
    <p>Manage user accounts in Supabase Authentication.</p>
    <p id="status" role="status" aria-live="polite"></p>

    <section>
      <h2>Add a user</h2>
      <form id="create-form">
        <label>Email
          <input name="email" type="email" required>
        </label>
        <label>Temporary password
          <input name="password" type="password" minlength="6" required>
        </label>
        <label>Display name
          <input name="display_name" type="text">
        </label>
        <button type="submit">Create user</button>
      </form>
    </section>

    <section>
      <h2>Existing users</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Email</th><th>Display name</th><th>Created</th><th>Update</th><th>Delete</th></tr>
          </thead>
          <tbody id="user-rows"></tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    const adminHeader = document.querySelector("header");
    const menuToggle = document.querySelector(".menu-toggle");
    menuToggle.addEventListener("click", () => {
      const isOpen = adminHeader.classList.toggle("menu-open");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
    });
    const statusLine = document.getElementById("status");
    const userRows = document.getElementById("user-rows");

    function setStatus(message) {
      statusLine.textContent = message;
    }

    // Use textContent for account data so user-provided values are shown as text.
    function makeTextCell(value, label) {
      const cell = document.createElement("td");
      cell.dataset.label = label;
      cell.textContent = value || "";
      return cell;
    }

    async function sendJson(url, method, body) {
      const response = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: body ? JSON.stringify(body) : undefined
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Request failed.");
      return result;
    }

    async function loadUsers() {
      setStatus("Loading users…");
      try {
        const response = await fetch("/api/users", { cache: "no-store" });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Could not load users.");

        userRows.replaceChildren();
        result.users.forEach((user) => {
          const row = document.createElement("tr");
          row.append(makeTextCell(user.email, "Email"));
          row.append(makeTextCell(user.user_metadata && user.user_metadata.display_name, "Display name"));
          row.append(makeTextCell(user.created_at ? new Date(user.created_at).toLocaleDateString() : "", "Created"));

          const updateCell = document.createElement("td");
          updateCell.dataset.label = "Update";
          const updateForm = document.createElement("form");
          updateForm.className = "row-form";
          updateForm.innerHTML =
            '<input name="email" type="email" aria-label="Updated email" placeholder="Email">' +
            '<input name="display_name" type="text" aria-label="Updated display name" placeholder="Display name">' +
            '<input name="password" type="password" aria-label="New password" placeholder="New password (optional)">' +
            '<button type="submit">Save</button>';
          updateForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            const formData = new FormData(updateForm);
            const body = {};
            for (const [key, value] of formData.entries()) {
              if (value.trim()) body[key] = value.trim();
            }
            try {
              await sendJson("/api/users/" + encodeURIComponent(user.id), "PATCH", body);
              setStatus("User updated.");
              await loadUsers();
            } catch (error) {
              setStatus(error.message);
            }
          });
          updateCell.append(updateForm);
          row.append(updateCell);

          const deleteCell = document.createElement("td");
          deleteCell.dataset.label = "Delete";
          const deleteButton = document.createElement("button");
          deleteButton.type = "button";
          deleteButton.className = "danger";
          deleteButton.textContent = "Delete";
          deleteButton.addEventListener("click", async () => {
            if (!window.confirm("Delete " + (user.email || "this user") + "?")) return;
            try {
              await sendJson("/api/users/" + encodeURIComponent(user.id), "DELETE");
              setStatus("User deleted.");
              await loadUsers();
            } catch (error) {
              setStatus(error.message);
            }
          });
          deleteCell.append(deleteButton);
          row.append(deleteCell);
          userRows.append(row);
        });

        setStatus("Showing " + result.users.length + " users.");
      } catch (error) {
        setStatus(error.message);
      }
    }

    // Submit new account details to the protected create-user route.
    document.getElementById("create-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const formData = new FormData(form);
      const body = Object.fromEntries(formData.entries());
      try {
        await sendJson("/api/users", "POST", body);
        form.reset();
        setStatus("User created.");
        await loadUsers();
      } catch (error) {
        setStatus(error.message);
      }
    });

    loadUsers();
  </script>
</body>
</html>


