<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#073763">
  <title><%= title %></title>
  <style>
    :root {
      color-scheme: light;
      --navy: #073763;
      --navy-deep: #05294a;
      --blue: #1768a6;
      --gold: #f3c969;
      --ink: #152a3d;
      --muted: #566b7e;
      --surface: #ffffff;
      --page: #f2f6fa;
      --border: #d9e3ec;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(ellipse at 80% 5%, rgba(243, 201, 105, .16), transparent 32rem),
        var(--page);
    }

    a { color: inherit; }

    .site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.15rem 1.5rem;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: .8rem;
      color: var(--navy);
      text-decoration: none;
      font-weight: 800;
      letter-spacing: -.03em;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      border-radius: .85rem;
      color: var(--navy-deep);
      background: var(--gold);
      font-size: 1.05rem;
      letter-spacing: -.05em;
    }

    .brand small {
      display: block;
      color: var(--muted);
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .header-note {
      color: var(--muted);
      font-size: .9rem;
    }

    main {
      width: min(1120px, calc(100% - 2rem));
      margin: 1.2rem auto 4rem;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 5.5rem);
      min-height: 390px;
      padding: clamp(1.5rem, 4vw, 3.5rem);
      overflow: hidden;
      border: 1px solid rgba(217, 227, 236, .8);
      border-radius: 1.5rem;
      background: rgba(255, 255, 255, .86);
      box-shadow: 0 24px 70px rgba(7, 55, 99, .09);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      margin: 0 0 1.1rem;
      color: var(--blue);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 1.5rem;
      height: 2px;
      background: var(--gold);
      content: "";
    }

    h1 {
      max-width: 13ch;
      margin: 0;
      color: var(--navy-deep);
      font-size: clamp(2.5rem, 5.2vw, 4.4rem);
      line-height: .99;
      letter-spacing: -.065em;
    }

    .hero-copy {
      max-width: 39rem;
      margin: 1.3rem 0 0;
      color: var(--muted);
      font-size: clamp(1rem, 1.4vw, 1.12rem);
      line-height: 1.75;
    }

    .hero-image-wrap {
      position: relative;
      min-height: 310px;
    }

    .hero-image {
      display: block;
      width: 100%;
      height: 360px;
      object-fit: cover;
      border-radius: 1.15rem;
      box-shadow: 0 20px 45px rgba(7, 55, 99, .16);
    }

    .image-caption {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: fit-content;
      max-width: calc(100% - 2rem);
      padding: .7rem .9rem;
      border: 1px solid rgba(255,255,255,.55);
      border-radius: .7rem;
      color: #fff;
      background: rgba(5, 41, 74, .78);
      backdrop-filter: blur(10px);
      font-size: .82rem;
      font-weight: 650;
    }

    .access-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, .85fr);
      align-items: center;
      gap: 2rem;
      margin-top: 1.25rem;
      padding: clamp(1.35rem, 3vw, 2.2rem);
      border-radius: 1.2rem;
      color: #fff;
      background: linear-gradient(120deg, var(--navy-deep), var(--navy));
      box-shadow: 0 18px 45px rgba(7, 55, 99, .15);
    }

    .access-panel h2 {
      margin: 0;
      font-size: clamp(1.35rem, 2.2vw, 1.8rem);
      letter-spacing: -.035em;
    }

    .access-panel p {
      max-width: 35rem;
      margin: .65rem 0 0;
      color: rgba(255,255,255,.76);
      line-height: 1.6;
    }

    .login-form {
      display: grid;
      grid-template-columns: 1fr 1fr auto;
      align-items: end;
      gap: .7rem;
    }

    .login-form label {
      display: grid;
      gap: .38rem;
      color: rgba(255,255,255,.86);
      font-size: .78rem;
      font-weight: 700;
    }

    .login-form input {
      width: 100%;
      min-width: 0;
      padding: .78rem .85rem;
      border: 1px solid rgba(255,255,255,.25);
      border-radius: .55rem;
      outline: none;
      color: var(--ink);
      background: #fff;
      font: inherit;
    }

    .login-form input:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(243, 201, 105, .25);
    }

    .button {
      display: inline-flex;
      min-height: 2.8rem;
      align-items: center;
      justify-content: center;
      padding: .72rem 1rem;
      border: 1px solid transparent;
      border-radius: .58rem;
      color: var(--navy-deep);
      background: var(--gold);
      cursor: pointer;
      font: inherit;
      font-weight: 800;
      text-decoration: none;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .button:hover {
      transform: translateY(-1px);
      box-shadow: 0 7px 18px rgba(0,0,0,.16);
    }

    .button.secondary {
      border-color: rgba(255,255,255,.34);
      color: #fff;
      background: rgba(255,255,255,.1);
    }

    .button.secondary:hover { background: rgba(255,255,255,.18); }

    .error-message {
      grid-column: 1 / -1;
      margin: 0;
      color: #ffe4e4;
      font-size: .9rem;
      font-weight: 650;
    }

    .signed-in-panel {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: .75rem;
    }

    .signed-in-copy {
      flex: 1 1 100%;
      margin-top: 0 !important;
    }

    .signed-in-copy strong { color: #fff; }

    .logout-form { margin: 0; }

    .page-footer {
      padding: 1.6rem 1rem 0;
      color: #728395;
      text-align: center;
      font-size: .82rem;
    }

    @media (max-width: 800px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 1.6rem;
      }

      .hero-image-wrap { min-height: 230px; }
      .hero-image { height: 300px; }
      .access-panel { grid-template-columns: 1fr; }
      .login-form { grid-template-columns: 1fr 1fr; }
      .login-form .button { grid-column: 1 / -1; }
    }

    @media (max-width: 520px) {
      .site-header { padding: .9rem 1rem; }
      .header-note { display: none; }
      main { width: min(100% - 1rem, 1120px); margin-top: .5rem; }
      .hero { padding: 1.3rem; border-radius: 1rem; }
      .hero-image-wrap { min-height: 190px; }
      .hero-image { height: 235px; border-radius: .8rem; }
      .access-panel { padding: 1.25rem; border-radius: 1rem; }
      .login-form { grid-template-columns: 1fr; }
      .login-form .button { grid-column: auto; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Cougar AI admin home">
      <span class="brand-mark" aria-hidden="true">CA</span>
      <span>Cougar AI <small>Admin portal</small></span>
    </a>
    <a class="button" href="https://rebekahkinghorn.github.io/cougarai/" target="_blank" rel="noopener noreferrer">Visit the main Cougar AI site</a>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">Welcome to Cougar AI</p>
        <h1 id="hero-title">A clearer path to your first year.</h1>
        <p class="hero-copy">
          Find answers, keep up with campus life, and make your next step at BYU
          feel a little easier. The admin portal keeps the information behind
          Cougar AI up to date.
        </p>
      </div>

      <div class="hero-image-wrap">
        <img
          class="hero-image"
          src="/images/cougar-campus.png"
          alt="Students walking together on a sunny university campus with mountains in the distance"
          width="1536"
          height="1024">
        <div class="image-caption">Start here. Find your people. Make campus yours.</div>
      </div>
    </section>

    <section class="access-panel" aria-labelledby="access-title">
      <% if (isAdmin) { %>
        <div class="signed-in-panel">
          <h2 id="access-title">Admin workspace</h2>
          <p class="signed-in-copy">Signed in as <strong><%= user.email %></strong>. Manage Cougar AI administrator accounts.</p>
          <a class="button" href="/users">Maintain Users</a>
          <a class="button secondary" href="/records">Maintain Records</a>
          
          <form class="logout-form" action="/logout" method="post">
            <button class="button secondary" type="submit">Log out</button>
          </form>
        </div>
      <% } else { %>
        <div>
          <h2 id="access-title">Administrator sign in</h2>
          <p>Sign in with your Cougar AI admin account to manage the site.</p>
        </div>
        <form class="login-form" action="/login" method="post">
          <% if (typeof error !== "undefined" && error) { %>
            <p class="error-message" role="alert"><%= error %></p>
          <% } %>
          <label for="user_email">
            Email
            <input id="user_email" name="user_email" type="email" autocomplete="username" required>
          </label>
          <label for="user_password">
            Password
            <input id="user_password" name="user_password" type="password" autocomplete="current-password" required>
          </label>
          <button class="button" type="submit">Log in</button>
        </form>
      <% } %>
    </section>

    <footer class="page-footer">
      Cougar AI · Built to help BYU students find their way.
    </footer>
  </main>
</body>
</html>


