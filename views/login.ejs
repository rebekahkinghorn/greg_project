<!-- login page -->
 <!DOCTYPE html>
 <html lang="en">
 <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <!-- bootstrap and styling -->

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">
    <style>
      body {
        min-height: 100vh;
        background: #f4f7fb;
      }

      .site-header {
        background: #fff;
        border-bottom: 1px solid #e8edf3;
      }

      .brand-mark {
        color: #17365d;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .welcome-panel {
        max-width: 760px;
        padding: 5rem 1.5rem;
      }

      @media (max-width: 767.98px) {
        .login-form {
          width: 100%;
          padding: 1rem 0;
        }

        .login-form .form-control,
        .login-form .btn {
          width: 100%;
        }

        .welcome-panel {
          padding-top: 3.5rem;
        }
      }
    </style>
 </head>
 <body>
        <form class="login-form ms-md-auto d-flex flex-column flex-md-row align-items-md-end gap-2"
              action="/login"
              method="post">
          <div>
            <label class="form-label small mb-1" for="user_email">Email</label>
            <input class="form-control" type="email" id="user_email" name="user_email"
                   placeholder="you@example.com" required>
          </div>
          <div>
            <label class="form-label small mb-1" for="user_password">Password</label>
            <input class="form-control" type="password" id="user_password" name="user_password"
                   placeholder="Password" required>
          </div>
          <button class="btn btn-primary px-4" type="submit">Sign in</button>
        </form>
 </body>
 </html>