<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Maintain Records | Greg Project</title>
  <style>
    :root {
      color-scheme: light;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #17243a;
      background: #f3f6fb;
      font-synthesis: none;
      text-rendering: optimizeLegibility;
    }

    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      background: radial-gradient(ellipse at 12% 0%, rgba(54, 106, 166, .10), transparent 34rem), #f3f6fb;
    }

    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem max(1.25rem, calc((100% - 1160px) / 2));
      background: rgba(255, 255, 255, .94);
      border-bottom: 1px solid #e1e8f1;
      box-shadow: 0 3px 14px rgba(30, 51, 81, .04);
    }

    .brand { display: flex; align-items: center; gap: .75rem; color: #182b48; font-size: 1rem; }
    .brand-mark { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: .8rem; color: #fff; background: #234d7d; font-size: 1.05rem; font-weight: 800; }
    .signed-in { color: #65748a; font-size: .88rem; }
    .signed-in strong { color: #34445b; font-weight: 600; }
    nav { display: flex; flex-wrap: wrap; gap: .55rem; align-items: center; }
    nav form { margin: 0; }

    main { width: min(1160px, calc(100% - 2rem)); margin: 2.5rem auto 4rem; }
    .page-heading { margin-bottom: 1.6rem; }
    .eyebrow { margin: 0 0 .45rem; color: #386b9d; font-size: .76rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
    h1 { margin: 0; color: #172b47; font-size: clamp(2rem, 4vw, 2.7rem); letter-spacing: -.04em; }
    .intro { margin: .55rem 0 0; color: #65748a; font-size: 1rem; }

    section { margin: 1.25rem 0; padding: clamp(1.1rem, 3vw, 1.7rem); background: #fff; border: 1px solid #e1e8f1; border-radius: 1rem; box-shadow: 0 12px 30px rgba(30, 51, 81, .055); }
    section h2 { margin: 0; color: #1c304d; font-size: 1.25rem; letter-spacing: -.02em; }
    .section-copy { margin: .4rem 0 1.25rem; color: #728097; font-size: .92rem; }

    #create-form { display: grid; grid-template-columns: minmax(180px, .9fr) minmax(260px, 1.5fr) auto; align-items: end; gap: 1rem; }
    label { display: grid; min-width: 0; gap: .45rem; color: #34445b; font-size: .9rem; font-weight: 650; }
    input, textarea { display: block; width: 100%; min-width: 0; padding: .75rem .85rem; color: #17243a; background: #fbfcfe; border: 1px solid #cdd7e4; border-radius: .6rem; font: inherit; font-weight: 400; transition: border-color .15s ease, box-shadow .15s ease, background .15s ease; }
    input:focus, textarea:focus { outline: none; background: #fff; border-color: #477fb3; box-shadow: 0 0 0 3px rgba(71, 127, 179, .15); }
    textarea { min-height: 3rem; resize: vertical; }

    button, a.button { display: inline-flex; min-height: 2.65rem; justify-content: center; align-items: center; padding: .65rem .95rem; border: 1px solid transparent; border-radius: .6rem; color: #fff; background: #234d7d; text-decoration: none; cursor: pointer; font: inherit; font-size: .9rem; font-weight: 650; white-space: nowrap; transition: background .15s ease, transform .15s ease, box-shadow .15s ease; }
    button:hover, a.button:hover { background: #183d68; box-shadow: 0 5px 12px rgba(35, 77, 125, .17); transform: translateY(-1px); }
    button:focus-visible, a.button:focus-visible { outline: 3px solid rgba(71, 127, 179, .35); outline-offset: 2px; }
    a.button.secondary { color: #304765; background: #edf2f8; border-color: #e0e7f0; }
    a.button.secondary:hover { background: #e1eaf4; }
    button.danger { color: #9e3340; background: #fff2f2; border-color: #f1d5d7; }
    button.danger:hover { color: #fff; background: #a93643; }

    #status { min-height: 1.35rem; margin: 0 0 .8rem; color: #52657e; font-size: .9rem; }
    .table-wrap { overflow-x: auto; border: 1px solid #e5eaf1; border-radius: .75rem; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { padding: .85rem .9rem; text-align: left; vertical-align: top; border-bottom: 1px solid #e9edf3; }
    th { color: #65748a; background: #f7f9fc; font-size: .76rem; font-weight: 750; letter-spacing: .045em; text-transform: uppercase; white-space: nowrap; }
    td { color: #34445b; font-size: .9rem; }
    tbody tr:last-child td { border-bottom: 0; }
    tbody tr:hover { background: #fbfcfe; }
    .edit-form { display: grid; min-width: 230px; gap: .5rem; }
    .edit-form input, .edit-form textarea { padding: .55rem .65rem; background: #fff; }
    .edit-form textarea { min-height: 3.5rem; }

    @media (max-width: 760px) {
      header { padding: .85rem 1rem; }
      main { width: min(100% - 1.25rem, 600px); margin-top: 1.5rem; }
      #create-form { grid-template-columns: 1fr; gap: .85rem; }
      #create-form button { justify-self: start; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <header>
    <div class="brand"><span class="brand-mark" aria-hidden="true">G</span><div><strong>Greg Project</strong><div class="signed-in">Signed in as <strong><%= adminUser.email %></strong></div></div></div>
    <nav>
      <a class="button" href="/">Back to Home</a>
      <a class="button secondary" href="/users">Maintain Users</a>
      <form action="/logout" method="post"><button type="submit">Log out</button></form>
    </nav>
  </header>

  <main>
    <div class="page-heading">
      <p class="eyebrow">Admin workspace</p>
      <h1>Maintain Records</h1>
      <p class="intro">Create and manage records for Cougar AI.</p>
    </div>
    <p id="status" role="status" aria-live="polite"></p>

    <section>
      <h2>Add a record</h2>
      <p class="section-copy">Add a new item to the shared project table.</p>
      <form id="create-form">
        <label>Name
          <input name="name" type="text" maxlength="200" required>
        </label>
        <label>Description
          <textarea name="description" maxlength="5000"></textarea>
        </label>
        <button type="submit">Create record</button>
      </form>
    </section>

    <section>
      <h2>Existing records</h2>
      <p class="section-copy">Edit details or remove an item from the table.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>ID</th><th>Name</th><th>Description</th><th>Created</th><th>Update</th><th>Delete</th></tr>
          </thead>
          <tbody id="record-rows"></tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    const statusLine = document.getElementById("status");
    const recordRows = document.getElementById("record-rows");

    function setStatus(message) {
      statusLine.textContent = message;
    }

    // Add database values as text nodes so record content is not treated as HTML.
    function makeCell(value) {
      const cell = document.createElement("td");
      cell.textContent = value == null ? "" : String(value);
      return cell;
    }

    async function requestJson(url, method, body) {
      const response = await fetch(url, {
        method,
        cache: "no-store",
        headers: { "Content-Type": "application/json" },
        body: body ? JSON.stringify(body) : undefined
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Request failed.");
      return result;
    }

    async function loadRecords() {
      setStatus("Loading records…");
      try {
        const response = await fetch("/api/records", { cache: "no-store" });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Could not load records.");

        recordRows.replaceChildren();
        result.records.forEach((record) => {
          const row = document.createElement("tr");
          row.append(makeCell(record.id));

          const updateCell = document.createElement("td");
          const editForm = document.createElement("form");
          editForm.className = "edit-form";

          const nameInput = document.createElement("input");
          nameInput.name = "name";
          nameInput.type = "text";
          nameInput.maxLength = 200;
          nameInput.required = true;
          nameInput.setAttribute("aria-label", "Record name");
          nameInput.value = record.name || "";

          const descriptionInput = document.createElement("textarea");
          descriptionInput.name = "description";
          descriptionInput.maxLength = 5000;
          descriptionInput.setAttribute("aria-label", "Record description");
          descriptionInput.value = record.description || "";

          editForm.append(nameInput, descriptionInput);

          row.append(makeCell(record.name));
          row.append(makeCell(record.description));
          row.append(makeCell(record.created_at ? new Date(record.created_at).toLocaleString() : ""));

          const saveCell = document.createElement("td");
          const saveButton = document.createElement("button");
          saveButton.type = "submit";
          saveButton.textContent = "Save";
          editForm.append(saveButton);
          editForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            try {
              await requestJson("/api/records/" + encodeURIComponent(record.id), "PATCH", {
                name: nameInput.value.trim(),
                description: descriptionInput.value.trim()
              });
              setStatus("Record updated.");
              await loadRecords();
            } catch (error) {
              setStatus(error.message);
            }
          });
          saveCell.append(editForm);
          row.append(saveCell);

          const deleteCell = document.createElement("td");
          const deleteButton = document.createElement("button");
          deleteButton.type = "button";
          deleteButton.className = "danger";
          deleteButton.textContent = "Delete";
          deleteButton.addEventListener("click", async () => {
            if (!window.confirm("Delete record " + record.id + "?")) return;
            try {
              await requestJson("/api/records/" + encodeURIComponent(record.id), "DELETE");
              setStatus("Record deleted.");
              await loadRecords();
            } catch (error) {
              setStatus(error.message);
            }
          });
          deleteCell.append(deleteButton);
          row.append(deleteCell);
          recordRows.append(row);
        });

        setStatus("Showing " + result.records.length + " records.");
      } catch (error) {
        setStatus(error.message);
      }
    }

    // Submit a new record and refresh the table without reloading the page.
    document.getElementById("create-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const body = Object.fromEntries(new FormData(form).entries());
      try {
        await requestJson("/api/records", "POST", body);
        form.reset();
        setStatus("Record created.");
        await loadRecords();
      } catch (error) {
        setStatus(error.message);
      }
    });

    loadRecords();
  </script>
</body>
</html>
